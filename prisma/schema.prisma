// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
    provider = "prisma-client"
    output   = "../generated/prisma"
}

datasource db {
    provider = "postgresql"
    url      = env("DATABASE_URL")
}

model Customer {
    id           String   @id @default(uuid())
    name         String
    email        String   @unique
    cpf          String   @unique
    password     String
    refreshToken String?  @map("refresh_token")
    phone        String?
    createdAt    DateTime @default(now()) @map("created_at")
    updatedAt    DateTime @updatedAt @map("updated_at")

    @@map("customers")
}

model Merchant {
    id           String         @id @default(uuid())
    name         String
    tradeName    String         @map("trade_name")
    email        String         @unique
    cnpj         String         @unique
    password     String
    refreshToken String?        @map("refresh_token")
    status       MerchantStatus @default(ACTIVE)
    createdAt    DateTime       @default(now()) @map("created_at")
    updatedAt    DateTime       @updatedAt @map("updated_at")

    @@map("merchants")
}

model Wallet {
    id        String          @id @default(uuid())
    ownerId   String          @unique @map("owner_id")
    ownerType WalletOwnerType @map("owner_type")
    balance   Int             @default(0)
    currency  String          @default("BRL")
    createdAt DateTime        @default(now()) @map("created_at")
    updatedAt DateTime        @updatedAt @map("updated_at")

    @@map("wallets")
}

model Transaction {
    id             String            @id @default(uuid())
    customerId     String            @map("customer_id")
    merchantId     String            @map("merchant_id")
    amountInCents  Int               @map("amount_in_cents")
    currency       String            @default("BRL")
    status         TransactionStatus @default(PENDING)
    description    String?
    idempotencyKey String?           @unique @map("idempotency_key")
    denialReason   String?           @map("denial_reason")
    metadata       Json?
    createdAt      DateTime          @default(now()) @map("created_at")
    updatedAt      DateTime          @updatedAt @map("updated_at")

    @@map("transactions")
}

model PaymentLink {
    id            String            @id @default(uuid())
    code          String            @unique
    merchantId    String            @map("merchant_id")
    amountInCents Int               @map("amount_in_cents")
    currency      String            @default("BRL")
    description   String?
    status        PaymentLinkStatus @default(ACTIVE)
    expiresAt     DateTime          @map("expires_at")
    usedAt        DateTime?         @map("used_at")
    createdAt     DateTime          @default(now()) @map("created_at")
    updatedAt     DateTime          @updatedAt @map("updated_at")

    @@map("payment_links")
}

model Deposit {
    id            String        @id @default(uuid())
    customerId    String        @map("customer_id")
    walletId      String        @map("wallet_id")
    amountInCents Int           @map("amount_in_cents")
    currency      String        @default("BRL")
    status        DepositStatus @default(PENDING)
    method        DepositMethod @default(PIX)
    createdAt     DateTime      @default(now()) @map("created_at")
    updatedAt     DateTime      @updatedAt @map("updated_at")
}

model Refund {
    id            String       @id @default(uuid())
    transactionId String       @unique @map("transaction_id")
    merchantId    String       @map("merchant_id")
    customerId    String       @map("customer_id")
    amountInCents Int          @map("amount_in_cents")
    currency      String       @default("BRL")
    reason        String?
    status        RefundStatus @default(PENDING)
    createdAt     DateTime     @default(now()) @map("created_at")
    updatedAt     DateTime     @updatedAt @map("updated_at")
}

model Webhook {
    id         String   @id @default(uuid())
    merchantId String   @map("merchant_id")
    url        String
    events     String[]
    secret     String
    isActive   Boolean  @default(true) @map("is_active")
    createdAt  DateTime @default(now()) @map("created_at")
    updatedAt  DateTime @updatedAt @map("updated_at")

    deliveries WebhookDelivery[]

    @@map("webhooks")
}

model WebhookDelivery {
    id            String                @id @default(uuid())
    webhookId     String                @map("webhook_id")
    event         String
    payload       Json
    statusCode    Int?                  @map("status_code")
    status        WebhookDeliveryStatus @default(PENDING)
    attempts      Int                   @default(0)
    lastAttemptAt DateTime?             @map("last_attempt_at")
    createdAt     DateTime              @default(now()) @map("created_at")

    webhook Webhook @relation(fields: [webhookId], references: [id])

    @@map("webhook_deliveries")
}

model ApiKey {
    id         String    @id @default(uuid())
    name       String
    keyHash    String    @unique @map("key_hash")
    keyPrefix  String    @map("key_prefix")
    isActive   Boolean   @default(true) @map("is_active")
    lastUsedAt DateTime? @map("last_used_at")
    createdAt  DateTime  @default(now()) @map("created_at")
    updatedAt  DateTime  @updatedAt @map("updated_at")

    @@map("api_keys")
}

enum WebhookDeliveryStatus {
    PENDING
    SUCCESS
    FAILED
}

enum RefundStatus {
    PENDING
    COMPLETED
    FAILED
}

enum PaymentLinkStatus {
    ACTIVE
    USED
    EXPIRED
}

enum DepositStatus {
    PENDING
    COMPLETED
    FAILED
}

enum DepositMethod {
    PIX
    TED
    BOLETO
}

enum TransactionStatus {
    PENDING
    APPROVED
    FAILED
    REFUNDED
}

enum MerchantStatus {
    ACTIVE
    INACTIVE
    SUSPENDED
}

enum WalletOwnerType {
    CUSTOMER
    MERCHANT
}
